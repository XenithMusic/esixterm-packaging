pkgname=esixterm
pkgver=0.3.3
pkgrel=1
pkgdesc="An e621 viewer for the terminal"
arch=('any')
url="https://github.com/XenithMusic/esixterm"
license=('GPLv3')
depends=('python' 'python-platformdirs' 'python-requests' 'python-webcolors' 'python-term-image' 'python-wcwidth')
source=("$pkgname-$pkgver.tar.gz::https://github.com/XenithMusic/esixterm/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('5b805a246686c04128f13373eb3e54d766bd0a13cef7abfa94690301858d3ad4')
conflicts=('esixterm-git')
provides=('esixterm')

package() {
    # enter the source
    cd "$srcdir/$pkgname-$pkgver"
    # install all files except esixterm (because it has different permissions) to /usr/lib
    find . -type f ! -name esixterm -exec install -Dm644 "{}" "$pkgdir/usr/lib/$pkgname/{}" \;
    # install esixterm to /usr/lib
    install -Dm755 esixterm "$pkgdir/usr/lib/$pkgname/esixterm"
    # install esixterm to /usr/bin
    install -d "$pkgdir/usr/bin"
    ln -s "/usr/lib/$pkgname/esixterm" "$pkgdir/usr/bin/esixterm"
}
